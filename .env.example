# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# COPERNICUS_CLIENT_ID & COPERNICUS_CLIENT_SECRET
# Copernicus Data Space Ecosystem (CDSE) / Sentinel Hub Process API OAuth credentials.
# Configure these in AI Studio Settings/Secrets or local .env to enable live Sentinel-2 L2A processing.
COPERNICUS_CLIENT_ID=""
COPERNICUS_CLIENT_SECRET=""
COPERNICUS_INSTANCE_ID=""

# DATABASE_URL: Optional external PostgreSQL/PostGIS connection string
DATABASE_URL=""

# PYTHON_GIS_SERVICE_URL: Optional external FastAPI Cloud Run microservice URL for advanced GeoPandas/Rasterio
PYTHON_GIS_SERVICE_URL=""
